{
  "manifestVersion": 1,
  "id": "community.animation-studio",
  "name": "Animation Studio",
  "version": "1.0.0",
  "description": "A Settings page for Hyprland animations: custom bezier curves, spring curves (Hyprland 0.56), per-leaf timings and styles, live preview and apply. Docs: docs/README.md.",
  "license": "AGPL-3.0-or-later",
  "author": "Big-Mac23",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.8 <1.4.0",
    "testedBaseCommits": [
      "c62a7acc443dbb1c9045e83466402528cc522af2"
    ]
  },
  "commands": [
    "bash"
  ],
  "permissions": [
    "Runs Lua in the running Hyprland (hl.curve / hl.animation) through the daemon's compositor.eval",
    "Reads and writes ~/.config/ambxst/config/animations.json and ~/.local/share/ambxst/animations.lua",
    "Watches axctl.toml and hyprland.lua in ~/.local/share/ambxst to re-apply after Ambxst regenerates them",
    "Only when you press Add loader or Remove in the page: edits ~/.config/hypr/hyprland.lua (a .animation-studio.bak backup is kept)",
    "Copies the generated Lua to the clipboard with wl-copy when you press Copy"
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/services/AnimationsLogic.js",
      "target": "modules/services/AnimationsLogic.js"
    },
    {
      "type": "overlay",
      "source": "payload/modules/services/AnimationsService.qml",
      "target": "modules/services/AnimationsService.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/widgets/dashboard/controls/AnimationsPanel.qml",
      "target": "modules/widgets/dashboard/controls/AnimationsPanel.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/widgets/dashboard/controls/CurvePreview.qml",
      "target": "modules/widgets/dashboard/controls/CurvePreview.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/widgets/dashboard/controls/MotionPreview.qml",
      "target": "modules/widgets/dashboard/controls/MotionPreview.qml"
    },
    {
      "type": "patch",
      "source": "patches/settings-tab.patch"
    },
    {
      "type": "patch",
      "source": "patches/settings-index.patch"
    },
    {
      "type": "patch",
      "source": "patches/shell-init.patch"
    }
  ]
}
